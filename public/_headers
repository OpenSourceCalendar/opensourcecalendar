# Headers for the React pages, which Cloudflare's assets layer serves without running the worker (wrangler.toml
# run_worker_first). The worker's own responses (/api/*, the website) don't get these.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'
  X-Content-Type-Options: nosniff

# Sign-in, sign-up and set-password pages: never inside another site's frame (no clickjacking), never cached, never leak the
# address. A second CSP header is a second policy; browsers enforce both.
/login
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Cache-Control: no-store
/login/*
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Cache-Control: no-store
/invite
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Cache-Control: no-store
/signup
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer
  Cache-Control: no-store
