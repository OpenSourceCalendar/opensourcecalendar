{
  "name": "booking-calendar",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json",
    "types": "wrangler types --strict-vars=false",
    "seed": "node scripts/seed-dev.mjs",
    "deploy:staging": "CLOUDFLARE_ENV=staging WRANGLER_CONFIG=wrangler.production.toml npm run build && wrangler deploy",
    "migrate:staging": "wrangler d1 migrations apply booking-calendar-staging --remote -c wrangler.production.toml --env staging",
    "migrate:prod": "wrangler d1 migrations apply booking-calendar --remote",
    "deploy:live": "WRANGLER_CONFIG=wrangler.production.toml npm run build && wrangler deploy",
    "migrate:live": "wrangler d1 migrations apply booking-calendar --remote -c wrangler.production.toml"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "hono": "4.13.18",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.40.1",
    "@cloudflare/vitest-pool-workers": "0.16.14",
    "@types/node": "^22.19.19",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vitest": "4.1.8",
    "wrangler": "4.99.0"
  }
}
